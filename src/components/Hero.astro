<script is:inline>
  const title = document.getElementById("animated-title");
  const titles = [
    `Facturación fácil y rápida <br /> <span class="bg-gradient-to-r from-[#55b290] to-[#6E8BFA] bg-clip-text text-transparent">pensada para emprendedores</span>`,
    `Todo tu negocio en un click: <br /> <span class="bg-gradient-to-r from-[#55b290] to-[#6E8BFA] bg-clip-text text-transparent">ventas, gastos e inventario</span>`,
    `Control total de tus ventas <br /> <span class="bg-gradient-to-r from-[#55b290] to-[#6E8BFA] bg-clip-text text-transparent">sin hojas de Excel, ni papel</span>`,
  ];

  let index = 0;
  setInterval(() => {
    title.style.opacity = "0";
    title.style.transform = "translateY(10px)";

    setTimeout(() => {
      index = (index + 1) % titles.length;
      title.innerHTML = titles[index];
      title.style.opacity = "1";
      title.style.transform = "translateY(0)";
    }, 500);
  }, 5000);
</script>

<style>
  /* Animaciones suaves de entrada */
  #animated-title {
    transition:
