---
// src/components/PopPrivacidad.astro
---

<div
  id="popup-privacidad"
  class="fixed bottom-6 right-6 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.1)] rounded-2xl p-6 max-w-[320px] w-full z-[1000] hidden border border-gray-100 transition-all duration-500 transform translate-y-0"
>
  <div class="absolute -top-10 left-1/2 -translate-x-1/2 drop-shadow-md">
    <div class="bg-white rounded-full p-2">
      <span class="text-4xl">🛡️</span>
    </div>
  </div>

  <div class="mt-4 text-center">
    <h3 class="text-xl font-bold text-[#1a1a1a] mb-3 leading-tight">
      Tu privacidad es <br /> importante para nosotros
    </h3>

    <p class="text-[13px] text-gray-500 mb-6 leading-relaxed">
      En <strong>CuarentaF</strong> procesamos tu información para mejorar tu experiencia
      y proteger tu negocio. Consulta nuestra <a
        href="/politica"
        class="text-blue-600 underline">Política de Privacidad</a
      >.
    </p>

    <div class="flex flex-col gap-3">
      <button
        id="cerrar-popup"
        class="w-full bg-[#55b290] hover:bg-[#449175] text-white font-bold py-3 rounded-xl transition-colors shadow-lg shadow-green-500/20"
      >
        Aceptar
      </button>

      <button
        id="opciones-popup"
        class="text-xs text-gray-400 font-medium hover:text-gray-600 transition-colors uppercase tracking-wider"
      >
        Más opciones
      </button>
    </div>
  </div>

  <script is:inline>
    const popup = document.getElementById("popup-privacidad");
    const cerrarBtn = document.getElementById("cerrar-popup");

    if (!localStorage.getItem("popupPrivacidadVisto")) {
      setTimeout(() => {
        popup.classList.remove("hidden");
        // Animación de entrada suave
        popup.animate(
          [
            { opacity: 0, transform: "translateY(20px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          { duration: 600, easing: "ease-out" },
        );
      }, 2000);
    }

    cerrarBtn.addEventListener("click", () => {
      popup.style.opacity = "0";
      popup.style.transform = "translateY(20px)";
      setTimeout(() => {
        popup.classList.add("hidden");
        localStorage.setItem("popupPrivacidadVisto", "true");
      }, 500);
    });
  </script>
</div>
