<section
  id="contacto"
  class="w-full bg-white py-24 px-6 relative overflow-hidden"
>
  <div
    class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-green-50 rounded-full blur-3xl opacity-50"
  >
  </div>

  <div
    class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center relative z-10"
  >
    <div class="space-y-6 text-center md:text-left">
      <div
        class="inline-flex items-center gap-2 bg-green-50 border border-green-100 px-4 py-1.5 rounded-full mb-2"
      >
        <span class="text-[#067c69] font-bold text-xs uppercase tracking-widest"
          >Atención Inmediata</span
        >
      </div>
      <h2 class="text-3xl md:text-5xl font-black text-[#343439] leading-tight">
        Comunícate con nuestro <span class="text-[#067c69]">equipo</span>
      </h2>
      <p class="text-gray-500 text-lg leading-relaxed max-w-md mx-auto md:mx-0">
        Si tienes preguntas, sugerencias o simplemente quieres optimizar tu
        negocio, estamos aquí para escucharte. ¡Te brindamos soporte 24/7!
      </p>

      <div class="pt-4 border-t border-gray-100 max-w-xs mx-auto md:mx-0">
        <p class="text-lg text-gray-800 italic">
          Descubre como <strong class="text-[#067c69] font-bold"
            >facturar fácil y rápido</strong
          >
        </p>
      </div>
    </div>

    <div
      class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl shadow-gray-200/60 border border-gray-100"
    >
      <form onsubmit="return sendToWhatsApp(event)" class="space-y-5">
        <div>
          <label
            for="nombre"
            class="block text-sm font-semibold text-gray-700 mb-2 ml-1"
            >¿Cómo te llamas?</label
          >
          <input
            id="nombre"
            type="text"
            placeholder="Escribe tu nombre completo"
            required
            class="w-full p-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#55b290] focus:border-transparent outline-none transition-all placeholder:text-gray-400 text-gray-800"
          />
        </div>

        <div>
          <label
            for="mensaje"
            class="block text-sm font-semibold text-gray-700 mb-2 ml-1"
            >Cuéntanos sobre tu negocio</label
          >
          <textarea
            id="mensaje"
            rows="4"
            placeholder="¿En qué podemos ayudarte hoy?"
            required
            class="w-full p-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#55b290] focus:border-transparent outline-none transition-all resize-none placeholder:text-gray-400 text-gray-800"
          ></textarea>
        </div>

        <div class="flex items-center gap-3 px-1 py-2">
          <input
            type="checkbox"
            id="terms"
            class="w-5 h-5 accent-[#067c69] rounded cursor-pointer"
            checked
            required
          />
          <label for="terms" class="text-sm text-gray-500 cursor-pointer">
            Acepto los <span class="font-bold text-gray-700"
              >Términos y Condiciones</span
            >.
          </label>
        </div>

        <button
          type="submit"
          class="group w-full bg-[#067c69] hover:bg-[#045e50] text-white font-bold py-4 px-6 rounded-2xl transition-all duration-300 shadow-lg shadow-green-900/10 flex items-center justify-center gap-3 active:scale-[0.98]"
        >
          <span>Enviar a WhatsApp</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    function sendToWhatsApp(e) {
      e.preventDefault();
      const nombre = document.getElementById("nombre").value;
      const mensaje = document.getElementById("mensaje").value;
      const texto = `Hola, soy ${nombre}. Me gustaría recibir información sobre CuarentaF: ${mensaje}`;
      const url = `https://wa.me/573003146150?text=${encodeURIComponent(texto)}`;
      window.open(url, "_blank");
      return false;
    }
  </script>
</section>
