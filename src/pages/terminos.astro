---
// src/pages/terminos.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsappButton from "../components/WhatsappButton.astro";
---

<BaseLayout title="Términos y Condiciones - CuarentaF">
  <Navbar />

  <main class="bg-gray-50 min-h-screen pt-40 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center gap-2 bg-[#6E8BFA]/10 border border-[#6E8BFA]/20 px-4 py-1.5 rounded-full mb-4"
        >
          <span
            class="text-[#6E8BFA] text-[10px] font-bold uppercase tracking-[0.2em]"
            >Acuerdo Legal</span
          >
        </div>
        <h1
          class="text-4xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight"
        >
          Términos y Condiciones
        </h1>
        <p class="text-gray-500 font-medium">
          Versión 2.0 • Efectivo desde Marzo 2026
        </p>
      </div>

      <div
        class="bg-white rounded-[2.5rem] shadow-2xl shadow-gray-200/60 border border-gray-100 overflow-hidden"
      >
        <div
          class="bg-gradient-to-r from-[#0c0c1d] to-[#121225] p-8 md:p-12 text-white"
        >
          <p class="text-lg opacity-90 leading-relaxed max-w-2xl">
            Al acceder y utilizar la plataforma <strong>CuarentaF</strong>,
            aceptas los siguientes términos. Hemos diseñado este acuerdo para
            ser claro, justo y proteger tanto tu negocio como nuestra
            tecnología.
          </p>
        </div>

        <div class="p-8 md:p-16 space-y-16">
          <section class="relative">
            <div class="flex flex-col md:flex-row gap-8">
              <div class="text-[#55b290] font-black text-4xl opacity-20">
                01
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                  Uso del servicio
                </h2>
                <p class="text-gray-600 leading-relaxed">
                  CuarentaF proporciona un ecosistema digital para la gestión
                  contable y facturación electrónica. Este servicio está
                  diseñado para potenciar el emprendimiento legal y responsable.
                  Cualquier uso indebido que comprometa la integridad de la
                  plataforma resultará en la revocación del acceso.
                </p>
              </div>
            </div>
          </section>

          <section class="relative">
            <div class="flex flex-col md:flex-row gap-8">
              <div class="text-[#6E8BFA] font-black text-4xl opacity-20">
                02
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                  Registro y seguridad
                </h2>
                <p class="text-gray-600 leading-relaxed">
                  Tu cuenta es personal e intransferible. Te comprometes a
                  proporcionar información veraz y a custodiar tus credenciales
                  con diligencia. Recuerda que tú eres el responsable de toda
                  actividad realizada bajo tu perfil.
                </p>
              </div>
            </div>
          </section>

          <section class="relative">
            <div class="flex flex-col md:flex-row gap-8">
              <div class="text-[#55b290] font-black text-4xl opacity-20">
                03
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                  Propiedad intelectual
                </h2>
                <p class="text-gray-600 leading-relaxed">
                  Nuestra tecnología, código, diseño visual y logotipos son
                  activos exclusivos de <strong>CuarentaF</strong>. Te otorgamos
                  una licencia de uso para gestionar tu negocio, pero los
                  derechos de autor permanecen bajo nuestra propiedad
                  intelectual.
                </p>
              </div>
            </div>
          </section>

          <section class="relative">
            <div class="flex flex-col md:flex-row gap-8">
              <div class="text-[#6E8BFA] font-black text-4xl opacity-20">
                04
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                  Responsabilidad
                </h2>
                <p class="text-gray-600 leading-relaxed">
                  Trabajamos para mantener una disponibilidad del 99.9%. No
                  obstante, no nos hacemos responsables por fallos en servicios
                  de terceros (como proveedores de internet) o pérdidas
                  indirectas de datos derivadas de un mal uso del sistema.
                </p>
              </div>
            </div>
          </section>

          <div
            class="pt-8 border-t border-gray-100 flex flex-col md:flex-row items-center justify-between gap-6"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center"
              >
                <span class="text-xl">📩</span>
              </div>
              <div>
                <p class="text-sm font-bold text-gray-900">¿Dudas legales?</p>
                <p class="text-xs text-gray-500">soporte@cuarentaf.com</p>
              </div>
            </div>
            <button
              onclick="window.print()"
              class="text-sm font-bold text-[#55b290] hover:text-[#449175] flex items-center gap-2 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 9V2h12v7"></path><path
                  d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                ></path><rect x="6" y="14" width="12" height="8"></rect></svg
              >
              Imprimir Términos
            </button>
          </div>
        </div>
      </div>

      <p class="mt-12 text-center text-gray-400 text-sm">
        Al usar nuestra plataforma, confirmas que has leído y comprendido estos
        términos.
      </p>
    </div>
  </main>

  <Footer />
  <WhatsappButton />
</BaseLayout>
